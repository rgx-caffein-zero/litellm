# Normalize line endings in the repository to LF.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never normalize or diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.woff  binary
*.woff2 binary
*.ttf   binary

# Lockfiles: collapse in diffs to keep reviews focused on source changes.
package-lock.json  linguist-generated=true -diff
pnpm-lock.yaml     linguist-generated=true -diff
yarn.lock          linguist-generated=true -diff
poetry.lock        linguist-generated=true -diff
uv.lock            linguist-generated=true -diff
Cargo.lock         linguist-generated=true -diff
go.sum             linguist-generated=true -diff
composer.lock      linguist-generated=true -diff
Gemfile.lock       linguist-generated=true -diff
