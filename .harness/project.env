# Harness configuration for this project.
#
# This file is sourced by scripts/harness/*.sh, so it must be valid bash.
# Every value is optional:
#   - empty / unset  -> auto-detect from the repository (see scripts/harness/detect.sh)
#   - "-"            -> disable the step explicitly
#   - any command    -> run this command instead of the detected one
#
# Run `scripts/harness/detect.sh --env` to print the detected commands in this format,
# then paste the lines you want to pin here.

# --- Quality gate steps -------------------------------------------------------
HARNESS_FORMAT_CMD=""        # Check formatting without modifying files.
HARNESS_FORMAT_FIX_CMD=""    # Apply formatting (used by `check.sh fix`).
HARNESS_LINT_CMD="scripts/lint.sh"
HARNESS_TYPECHECK_CMD=""
HARNESS_TEST_CMD="tests/run.sh"
HARNESS_BUILD_CMD=""
HARNESS_SECRETS_CMD=""       # Empty -> gitleaks if installed, otherwise the built-in scanner.

# Steps that must resolve to a command. If one of these has no command,
# `check.sh --strict` (used in CI) fails instead of silently skipping it.
HARNESS_REQUIRED_STEPS="lint test"

# --- Single-file formatting (Claude Code post-edit hook) ----------------------
# "{file}" is replaced with the edited file path. Empty -> detect by extension.
HARNESS_FORMAT_FILE_CMD=""

# --- Git hooks ----------------------------------------------------------------
HARNESS_PRECOMMIT_MODE="quick"   # quick | full | off
HARNESS_COMMIT_MAX_HEADER="72"

# --- Claude Code stop hook ------------------------------------------------------
HARNESS_STOP_CHECK="quick"       # quick | full | off
