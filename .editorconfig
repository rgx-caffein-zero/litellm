# https://editorconfig.org
# Baseline for editors. Language formatters (prettier, ruff, gofmt, ...) take precedence.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,pyi,rs,java,kt,kts,cs,php,swift,scala}]
indent_size = 4

[{*.go,go.mod,go.sum,Makefile,*.mk}]
indent_style = tab
indent_size = 4

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf
