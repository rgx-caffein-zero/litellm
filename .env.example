# .env のひな形。コピーして値を設定する: cp .env.example .env && chmod 600 .env
# .env は Git にコミットしないこと（.gitignore で除外済み）。

# --- LiteLLM -------------------------------------------------------------------
# 管理者用のマスターキー。管理 UI のログイン（ユーザー名 admin）にも使う。
# 生成例: printf 'sk-%s\n' "$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=

# DB に保存する認証情報（Azure の API キーなど）を暗号化する鍵。
# 一度設定したら変更しないこと。変更・紛失すると、保存済みの認証情報を復号できなくなる。
# 必ず .env ごとバックアップする（README.md の「バックアップとリストア」）。
# 生成例: printf 'sk-%s\n' "$(openssl rand -hex 32)"
LITELLM_SALT_KEY=

# --- PostgreSQL ----------------------------------------------------------------
# 生成例: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- AWS Bedrock -----------------------------------------------------------------
# Bedrock の InvokeModel 権限を持つ IAM ユーザーのアクセスキー。
# 任意。空でも LiteLLM は起動するが、Bedrock のモデルへのリクエストは 500 エラー（Unable to locate credentials）になる。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# --- プロキシ ------------------------------------------------------------------
# LiteLLM コンテナが Bedrock・Azure OpenAI などへ接続するときに使うプロキシ。
# 任意。空の場合はプロキシを使わずに直接接続する。
# 認証が必要な場合は http://<ユーザー>:<パスワード>@<ホスト>:<ポート> とする（記号は URL エンコードする）。
# イメージの取得（docker compose pull）には使われない（README.md の「プロキシ環境の場合」）。
# 例: LITELLM_HTTPS_PROXY=http://proxy.example.co.jp:8080
LITELLM_HTTP_PROXY=
LITELLM_HTTPS_PROXY=
# プロキシを通さない宛先（カンマ区切り。ホスト名、.ドメイン、IP アドレス。CIDR は使えない）。
# localhost・127.0.0.1・db は常に含まれるので、書かなくてよい。
# 例: LITELLM_NO_PROXY=.corp.example.co.jp,10.1.2.3
LITELLM_NO_PROXY=

# --- nginx -----------------------------------------------------------------------
# 公開する HTTPS ポート。既定は 443。
HTTPS_PORT=443

# 管理 UI・管理 API に接続できる IP 範囲（CIDR。複数ある場合は空白で区切る）。
# それ以外の PC からは、推論 API とヘルスチェックだけが使える。
# 任意。空の場合は接続元を制限しない（管理系はマスターキーの認証だけで守られる）。
# サーバー上で管理 API を使う場合は、サーバー自身の IP も含める。
# 全開放（0.0.0.0/0）と、Docker のブリッジ範囲（172.16.0.0/12 など）は指定しないこと（README.md の「.env の作成」）。
# 空白を含むので二重引用符で囲む（手順書では `. ./.env` でシェルとしても読み込むため）。
# 例: ADMIN_ALLOW_CIDRS="10.1.5.0/24 10.1.2.3/32"（管理者のセグメントとサーバー自身）
ADMIN_ALLOW_CIDRS=
